{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!assets|downloads|headshot|favicon).*)", "destination": "/index.html" }
  ],
  "redirects": [
    {
      "source": "/tt",
      "destination": "/?utm_source=tiktok&utm_medium=bio&utm_campaign=cohort1",
      "permanent": false
    },
    {
      "source": "/ig",
      "destination": "/?utm_source=instagram&utm_medium=bio&utm_campaign=cohort1",
      "permanent": false
    },
    {
      "source": "/fb",
      "destination": "/?utm_source=facebook&utm_medium=profile&utm_campaign=cohort1",
      "permanent": false
    },
    {
      "source": "/tt-c",
      "destination": "/coaching?utm_source=tiktok&utm_medium=bio&utm_campaign=cohort1",
      "permanent": false
    },
    {
      "source": "/downloads",
      "destination": "/library",
      "permanent": false
    },
    { "source": "/challenge", "destination": "/", "permanent": false },
    { "source": "/coaching", "destination": "/", "permanent": false }
  ],
  "crons": [
    {
      "path": "/api/calendly-poll-cron",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/postiz-cron",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cohort-saturday-cron",
      "schedule": "0 12 16 5 *"
    },
    {
      "path": "/api/cohort-sunday-cron",
      "schedule": "0 13 17 5 *"
    },
    {
      "path": "/api/reply-agent",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/daily-digest",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/lead-cron",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/tier-1-cron",
      "schedule": "45 12 * * *"
    },
    {
      "path": "/api/tier-2-cron",
      "schedule": "30 13 * * *"
    },
    {
      "path": "/api/tier-3-cron",
      "schedule": "45 13 * * *"
    },
    {
      "path": "/api/tier-4-cron",
      "schedule": "30 14 * * *"
    }
  ]
}
