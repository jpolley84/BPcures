{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!assets|downloads|headshot|favicon|tea/|tea$|coaching/|masterclass/|masterclass$|privacy-app/|privacy-app$|support-app/|support-app$).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/tt",
      "destination": "/?utm_source=tiktok&utm_medium=bio&utm_campaign=cohort1",
      "permanent": false
    },
    {
      "source": "/ig",
      "destination": "/?utm_source=instagram&utm_medium=bio&utm_campaign=cohort1",
      "permanent": false
    },
    {
      "source": "/fb",
      "destination": "/?utm_source=facebook&utm_medium=profile&utm_campaign=cohort1",
      "permanent": false
    },
    {
      "source": "/tea",
      "destination": "/tea/?utm_source=manychat&utm_medium=comment-dm&utm_campaign=tea",
      "permanent": false
    },
    {
      "source": "/tt-c",
      "destination": "/coaching?utm_source=tiktok&utm_medium=bio&utm_campaign=cohort1",
      "permanent": false
    },
    {
      "source": "/igdm",
      "destination": "/?utm_source=instagram&utm_medium=comment-dm&utm_campaign=manychat",
      "permanent": false
    },
    {
      "source": "/fbdm",
      "destination": "/?utm_source=facebook&utm_medium=comment-dm&utm_campaign=manychat",
      "permanent": false
    },
    {
      "source": "/magnesium",
      "destination": "https://www.tiktok.com/t/ZP9Mo41fRtHnU-pux7n/",
      "permanent": false
    },
    {
      "source": "/saffron",
      "destination": "https://www.tiktok.com/t/ZP9rebBAGVd8G-duWOM/",
      "permanent": false
    },
    {
      "source": "/downloads",
      "destination": "/library",
      "permanent": false
    },
    {
      "source": "/podcast",
      "destination": "/quiz?utm_source=podcast&utm_medium=spoken",
      "permanent": false
    },
    {
      "source": "/seminar",
      "destination": "/quiz?utm_source=seminar-legacy",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/calendly-poll-cron",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/postiz-cron",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/reply-agent",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/daily-digest",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/triangle-lead-cron",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/sprint-flash-cron",
      "schedule": "45 15 * * *"
    },
    {
      "path": "/api/evergreen-cron",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/masterclass-reminder?stage=60",
      "schedule": "0 23 * * 1"
    },
    {
      "path": "/api/masterclass-reminder?stage=10",
      "schedule": "50 23 * * 1"
    },
    {
      "path": "/api/triangle-buyer-cron",
      "schedule": "30 15 * * *"
    },
    {
      "path": "/api/tea-daily-cron",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/reconcile-purchases",
      "schedule": "30 8 * * *"
    }
  ]
}
