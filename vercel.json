{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!assets|downloads|headshot|favicon).*)", "destination": "/index.html" }
  ],
  "redirects": [
    {
      "source": "/tt",
      "destination": "/?utm_source=tiktok&utm_medium=bio&utm_campaign=cohort1",
      "permanent": false
    },
    {
      "source": "/ig",
      "destination": "/?utm_source=instagram&utm_medium=bio&utm_campaign=cohort1",
      "permanent": false
    },
    {
      "source": "/fb",
      "destination": "/?utm_source=facebook&utm_medium=profile&utm_campaign=cohort1",
      "permanent": false
    },
    {
      "source": "/tt-c",
      "destination": "/coaching?utm_source=tiktok&utm_medium=bio&utm_campaign=cohort1",
      "permanent": false
    },
    {
      "source": "/downloads",
      "destination": "/library",
      "permanent": false
    },
    {
      "source": "/podcast",
      "destination": "/quiz?utm_source=podcast&utm_medium=spoken",
      "permanent": false
    },
    { "source": "/seminar", "destination": "/quiz?utm_source=seminar-legacy", "permanent": false }
  ],
  "crons": [
    {
      "path": "/api/calendly-poll-cron",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/postiz-cron",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/reply-agent",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/daily-digest",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/tier-1-cron",
      "schedule": "45 12 * * *"
    },
    {
      "path": "/api/tier-2-cron",
      "schedule": "30 13 * * *"
    },
    {
      "path": "/api/tier-3-cron",
      "schedule": "45 13 * * *"
    },
    {
      "path": "/api/tier-4-cron",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/triangle-lead-cron",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/triangle-buyer-cron",
      "schedule": "30 15 * * *"
    },
    {
      "path": "/api/newsletter-cron",
      "schedule": "0 16 * * 2"
    }
  ]
}
