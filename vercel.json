{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/go/:product",
      "destination": "/api/go?product=:product"
    },
    {
      "source": "/next",
      "destination": "/cohort-apply/index.html"
    },
    {
      "source": "/next/",
      "destination": "/cohort-apply/index.html"
    },
    {
      "source": "/apply",
      "has": [{ "type": "host", "value": "changemylifechallenge.com" }],
      "destination": "/cohort-apply/index.html"
    },
    {
      "source": "/apply/",
      "has": [{ "type": "host", "value": "changemylifechallenge.com" }],
      "destination": "/cohort-apply/index.html"
    },
    {
      "source": "/apply",
      "has": [{ "type": "host", "value": "www.changemylifechallenge.com" }],
      "destination": "/cohort-apply/index.html"
    },
    {
      "source": "/((?!assets|downloads|headshot|favicon|tea/|tea$|tea-review/|tea-review$|challenge-b/|challenge-b$|cohort-apply/|cohort-apply$|next/|next$|coaching/|masterclass/|masterclass$|privacy-app/|privacy-app$|support-app/|support-app$).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/challenge",
      "has": [
        {
          "type": "host",
          "value": "bpquiz.com"
        }
      ],
      "destination": "https://changemylifechallenge.com/",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.changemylifechallenge.com"
        }
      ],
      "destination": "https://changemylifechallenge.com/$1",
      "permanent": true
    },
    {
      "source": "/tt",
      "destination": "/?utm_source=tiktok&utm_medium=bio&utm_campaign=cohort1",
      "permanent": false
    },
    {
      "source": "/ig",
      "destination": "/?utm_source=instagram&utm_medium=bio&utm_campaign=cohort1",
      "permanent": false
    },
    {
      "source": "/fb",
      "destination": "/?utm_source=facebook&utm_medium=profile&utm_campaign=cohort1",
      "permanent": false
    },
    {
      "source": "/tt-c",
      "destination": "/coaching?utm_source=tiktok&utm_medium=bio&utm_campaign=cohort1",
      "permanent": false
    },
    {
      "source": "/igdm",
      "destination": "/quiz?utm_source=instagram&utm_medium=comment-dm&utm_campaign=manychat",
      "permanent": false
    },
    {
      "source": "/fbdm",
      "destination": "/quiz?utm_source=facebook&utm_medium=comment-dm&utm_campaign=manychat",
      "permanent": false
    },
    {
      "source": "/magnesium",
      "destination": "https://www.tiktok.com/t/ZP9Mo41fRtHnU-pux7n/",
      "permanent": false
    },
    {
      "source": "/maxcalm",
      "destination": "/magnesium",
      "permanent": false
    },
    {
      "source": "/saffron",
      "destination": "https://www.tiktok.com/t/ZP9rebBAGVd8G-duWOM/",
      "permanent": false
    },
    {
      "source": "/downloads",
      "destination": "/library",
      "permanent": false
    },
    {
      "source": "/podcast",
      "destination": "/quiz?utm_source=podcast&utm_medium=spoken",
      "permanent": false
    },
    {
      "source": "/seminar",
      "destination": "/quiz?utm_source=seminar-legacy",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/calendly-poll-cron",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/postiz-cron",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/reply-agent",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/daily-digest",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/triangle-lead-cron",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/sprint-flash-cron",
      "schedule": "45 15 * * *"
    },
    {
      "path": "/api/evergreen-cron",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/triangle-buyer-cron",
      "schedule": "30 15 * * *"
    },
    {
      "path": "/api/tea-daily-cron",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/reconcile-purchases",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/case-review-nudge-cron",
      "schedule": "15 16 * * *"
    }
  ]
}
